# App defaults — safe to commit. Secrets (API keys) go in .env (gitignored).
#
# ── HOW TO RUN ────────────────────────────────────────────────────────────────
#   python3 Xup.py                  normal bot — real X posting on the 5h cadence
#   python3 nXtest_no_posting.py    speed-run test, NO posting (dry, isolated under
#                                   test_run/<timestamp>/, re-runnable; Ctrl-C to stop)
#   python3 wXtest_with_posting.py  speed-run test that POSTS to X for real (fast;
#                                   lower the posts' visibility first; Ctrl-C to stop)
#   Speed-runs use no waits + bypass the 5h interval & daily cap. iCloud + AI calls
#   (judge, dedup, grouping, rotation, color enhance) are ALWAYS REAL and cost money.
#   (Advanced CLI equivalent: `ic2x bot [--test [--post]] [--test-cycles N]`.)
#
# Model settings: MODEL_VAR=<model>[, <thinking>][, <max_output_tokens>]
#   thinking: off | low | high, or a digit = qwen thinking-token budget
#   max_output_tokens: a digit capping TOTAL output tokens (cost ceiling)
#   e.g. JUDGE_MODEL=qwen3.7-plus, 1000, 2000   |   ROTATION_MODEL=gemini-2.5-flash, off
#
# Available models: (aligned with eXercise catalog — see eXercise/default.env for thinking-token notes)
#   Local Ollama  (no API key needed — runs on OLLAMA_BASE_URL)
#     qwen3-vl:8b                 — vision-language, fast on local GPU
#     qwen3-vl:30b                — higher quality (add to exact_models in ai_client.py)
#
#   Google Gemini  (GEMINI_API_KEY)
#     gemini-2.5-flash              — fast, good quality      [thinking: off/low/high]
#     gemini-2.5-flash-lite         — cheapest / fastest      [thinking: off/low/high]
#     gemini-2.5-pro                — best stable quality     [thinking: always on]
#     gemini-3.5-flash        — frontier quality        [thinking: always on]
#     gemini-3.1-pro-preview        — best quality (preview)  [thinking: always on]
#     gemini-3.1-flash-lite — cheapest Gemini 3       [thinking: always on]
#
#   xAI Grok  (XAI_API_KEY)
#     grok-4                        — flagship
#     grok-4-1-fast-non-reasoning   — fast, low cost
#
#   Alibaba Qwen  (DASHSCOPE_API_KEY)
#     qwen3.6-plus                  — balanced quality/speed  [thinking: off/high]
#     qwen3.5-plus                  — fast                    [thinking: off/high]
#     qwen3.6-flash                 — better / fastest        [thinking: off/high]
#     qwen3.5-flash                 — cheapest / fastest      [thinking: off/high]
#     qwen3-max                     — best quality            [thinking: off/high]
#     qwen3-vl-flash                — vision-language, fast   [thinking: off/high]
#     qwen3-vl-plus                 — vision-language         [thinking: off/high]
#
#   Moonshot Kimi  (KIMI_API_KEY)
#     ic2x sends vision as JPEG via OpenAI-compatible image_url only; PDF file-extract
#     (kimi_pdf_text) remains eXercise/xScore, not wired here.
#     kimi-k2.6                     — flagship (Apr 2026), 256K, multimodal  [thinking: off/on]
#     kimi-k2.5                     — multimodal, stable                     [thinking: off/on]
#     kimi-k2-turbo-preview         — Moonshot doc-default                   [thinking: off/on]
#     moonshot-v1-128k              — legacy text-only                       [thinking: n/a]
#     KIMI_BASE_URL                 — optional; default China (.cn); https://api.moonshot.ai/v1 intl

# Optional: reproducible sampling (injected when not set per request; kimi-k2* skips temperature).
# ALL_AI_TEMPERATURE=0
# ALL_AI_SEED=42

# ── AI observability / debugging ──────────────────────────────────────────────
# IC2X_AI_RETRY_MAX_ATTEMPTS=4
# IC2X_AI_RETRY_BASE_SLEEP=0.1

# Disk cache for judge JSON responses (default off). Cache hits do not increment DAILY_AI_CALLS.
# IC2X_AI_RESPONSE_CACHE=1
# IC2X_AI_RESPONSE_CACHE_DIR=~/.cache/ic2x/responses
# IC2X_AI_RESPONSE_CACHE_OLLAMA=1   # allow caching local Ollama (default: cloud only)

# Save text prompts + responses (no base64) for debugging.
# IC2X_AI_PROMPT_LOG_DIR=./logs/ai_prompts

# Optional override for pricing JSON or .xlsx (default: data/ai_pricing_per_mtoken.json; RMB).
# Point at eXercise "AI API costs.xlsx" to match xScore live sheet (needs openpyxl).
# IC2X_AI_PRICING_JSON=
# Maintainer: set IC2X_AI_PRICING_SOURCE_XLSX or pass path to regenerate committed JSON:
#   uv run --with openpyxl python scripts/export_pricing_from_exercise_xlsx.py
# IC2X_AI_PRICING_SOURCE_XLSX=
# Append daily cost markdown + overwrite logs/ai_costs/latest.json after each run (default on).
# Set 0 / false / no / off to disable (e.g. high-frequency daemon on small disks).
# IC2X_AI_COST_ARTIFACTS=1

OLLAMA_BASE_URL=http://localhost:11434/v1

# Max long-edge pixel size for images sent to Ollama.
# Unset = full resolution (best for dedicated GPU / Tailscale offload).
# Set to 1024 on memory-constrained machines to cap KV cache RAM usage.
# OLLAMA_IMAGE_MAX_PX=1024

# Fallback model for all ic2x AI calls. qwen3.5-flash with a CAPPED thinking
# budget (the ", 3000" suffix = max 3000 reasoning tokens) — richer captions +
# stricter safety than gemini, while the cap holds cost to ~¥0.005/image typical,
# ~¥0.01/image worst case. Needs DASHSCOPE_API_KEY. Cheaper-but-less-careful
# alternative: gemini-2.5-flash-lite (~¥0.001/image, no thinking; needs GEMINI_API_KEY).
# Tune the budget or compare: `ic2x compare --models "gemini-2.5-flash-lite; qwen3.5-flash, 1000"`.
AI_DEFAULT_MODEL=qwen3.5-flash, 3000

# Burst judge — one multi-image call per burst picks the best shot + vets it.
# qwen3.7-plus with thinking budget 1000 + max output 2000 (defined, not unbounded).
JUDGE_MODEL=qwen3.7-plus, 1000, 2000

# Owner-specific rules + account angle, appended to the judge prompt. Edit freely.
JUDGE_EXTRA_RULES=HARD RULES (override everything): (1) The owner is a teacher — NEVER post students: set safe=false with flag "students" for any image showing students, a classroom, lecture hall, study group, exam, or identifiable people in a teaching/studying context, even adults. (2) Never post the interior of the owner's own home or apartment (interesting=false). AUDIENCE & ANGLE: this account is run by a foreigner living in China FOR a non-Chinese audience — judge "interesting" as a viewer OUTSIDE China would. The test is INFORMATIONAL VALUE: does this image show or teach an outsider something about China — its life, food, places, street scenes, culture, scale, or MODERNITY? Judge by that, NOT by whether the photo is pretty or unique; ordinary is fine. Everyday food and scenery (meals, rivers, sunsets, parks, street life, markets) count — AND so do modern, urban, commercial scenes: a vast shopping-mall interior, a busy plaza or atrium, neon-lit shopping streets, supermarkets, transit hubs, city life. Many foreigners picture China as only old or rural, so contemporary consumer/urban life is HIGH informational value — POST it, even if brand banners, shops, or signs appear in the scene. Set interesting=false ONLY when the main subject is a bare CLOSE-UP of a single sign, label, logo, poster, or shop entrance with no surrounding scene, OR an empty/boring frame whose only point of interest is text a foreigner cannot read. A WIDE interior or street that merely CONTAINS signs, banners, or brand names is a SCENE — keep it; the presence of text or brands is NOT disqualifying.

# Max long-edge pixel size for images sent to the judge (cloud providers).
# Unset = 1024. Override only if you need higher/lower resolution.
# JUDGE_IMAGE_MAX_PX=1024

# ── iCloud ────────────────────────────────────────────────────────────────────
# ICLOUD_USERNAME + ICLOUD_PASSWORD must be set in .env. Run `ic2x login` once to
# establish the 2FA session (persists in ICLOUD_COOKIE_DIR for ~weeks).
ICLOUD_USERNAME=
ICLOUD_COOKIE_DIR=./icloud_auth
# Include the shared family library? Unsafe for auto-posting; requires the
# explicit override I_KNOW_FAMILY_PHOTOS_ARE_PUBLIC=true in .env to take effect.
ICLOUD_WITH_FAMILY=false
# Set true only if the Apple ID is China-mainland (different Apple endpoint).
ICLOUD_CHINA_MAINLAND=false

# ── Paths (relative to project root) ─────────────────────────────────────────
WORK_DIR=./work          # scratch for thumbnail + original downloads
QUEUE_DIR=./queue
APPROVED_DIR=./approved
POSTED_DIR=./posted
DB_PATH=./state.db
LOGS_DIR=./logs

# Save every judged thumbnail to reviewed/<date>/ named by outcome
# (posted__/boring__/unsafe__/duplicate__…) so you can browse what the bot saw
# and decided. Great for burn-in; set false in production to stop disk growth.
KEEP_REVIEWED=true
REVIEWED_DIR=./reviewed

# ── Proxy — IC2X_ prefix avoids clashing with system HTTP_PROXY ──────────────
IC2X_HTTP_PROXY=
IC2X_HTTPS_PROXY=

# ── X / Twitter ───────────────────────────────────────────────────────────────
# true = simulate posts (advance state, no real tweet). Keep true during burn-in.
X_DRY_RUN=true
# `ic2x bot --test` (or IC2X_TEST_MODE=true) = fast dry-run soak: forces dry-run,
# no waits, isolated throwaway state under test_run/ (real state untouched).
# Dry only for X — iCloud + all AI calls are REAL. Bounded by --test-cycles (default 20).
IC2X_TEST_MODE=false

# ── Location stamp ────────────────────────────────────────────────────────────
# Append "📍 HH:MM City, Country" as a second caption line — the photo's local
# capture time (EXIF DateTimeOriginal) directly before the city, which comes from
# the GPS EXIF reverse-geocoded via BigDataCloud (free, no key, returns a
# recognizable city — e.g. "Ningbo", not the raw district). City-level only; the
# posted JPEG has EXIF stripped, so exact coordinates are NEVER shared. Best-effort:
# photos with no GPS (or if geocoding fails / times out) simply post without the line.
LOCATION_ENABLED=true
# LOCATION_TIMEOUT=10   # seconds allowed for the reverse-geocode HTTP call

# ── Caption pass ──────────────────────────────────────────────────────────────
# The FINAL caption is written by a dedicated VLM pass on the chosen winner, AFTER
# its city + local time are known (the burst judge only sees EXIF-stripped thumbs,
# so it can't know the place and defaults to generic "vibrant modern urban life"
# filler). The pass is TOLD the place + time and prompted to tie ONE specific, real
# thing in the photo to ONE true piece of local/China knowledge — a knowledgeable-
# local voice, brochure clichés banned. Costs 1 extra vision call per POST (~1/5h).
# Best-effort: if it fails, the judge's caption is used. Set false to disable.
CAPTION_PASS_ENABLED=true

# ── Limits / dedup ────────────────────────────────────────────────────────────
DAILY_AI_CALLS=200       # also bounds walk-back cost per day
HAMMING_THRESHOLD=12     # cross-library pHash dedup distance

# ── Burst assembly ────────────────────────────────────────────────────────────
BURST_HAMMING_THRESHOLD=8   # consecutive-shot similarity (tighter than dedup)
BURST_MAX_SIZE=5            # images per burst sent to the judge (token guard)
BURST_MAX_ATTEMPTS=3       # pre-commit failures before a burst is skipped as error
THUMB_VERSION=thumb        # rendition for burst eval: thumb | medium
SCREENSHOT_ALBUM_REFRESH=20 # cycles between Screenshots-album flag refreshes
# Thumbnails per batch downloaded + hashed in PARALLEL while assembling a burst
# (the sequential similarity logic is unchanged; this only hides network latency).
# Keep modest — too high risks iCloud throttling. 1 = fully serial (old behaviour).
PREFETCH_CONCURRENCY=6

# ── Posting / loop ────────────────────────────────────────────────────────────
POST_INTERVAL_HOURS=5      # minimum hours between posts
DAEMON_CHECK_INTERVAL=1800 # loop poll granularity (seconds)
MAX_POSTS_PER_DAY=6        # rolling-24h safety backstop
POST_MAX_ATTEMPTS=3        # flush retries before REJECTED(post_failed)
# Shell command run when iCloud re-auth is needed (e.g. a push notification).
REAUTH_NOTIFY_CMD=

# ── Startup reconciliation (sync DB with X) ──────────────────────────────────
# At the start of EVERY bot run, check whether the last N DB posts still exist on X
# (Bearer get_tweets by id — needs TWITTER_BEARER_TOKEN in .env). Any post the owner
# DELETED on X is re-queued (the iCloud photo gets posted again); captions of still-
# live posts are filled if missing. Fail-open; a --test run's fresh DB makes it a no-op.
RECONCILE_ON_STARTUP=true
RECONCILE_RECENT_N=50              # how many recent X posts to check
RECONCILE_MAX_REQUEUE_PER_RUN=20   # sanity cap — skip if more look deleted (bad read)

# ── Rotation (AI orientation pass — pick-4: model picks the upright version) ─
# Sends all 4 rotations of the photo (shuffled order, ≤512px each) in ONE
# multi-image call and asks which one is upright — VLMs are far better at picking
# the upright version than at estimating a rotation. The legacy single-image
# "estimate CW degrees" method turned sideways photos UPSIDE-DOWN: given photos
# rotated 90° CW it answered 90° instead of 270° in 12/13 cases (qwen3.7-plus,
# 2026-07-10 eval). Pick-4 on qwen3.5-flash: 88/88 exact fixes on synthetically
# rotated real photos (22 scenes × 0/90/180/270 incl. all 180° flips), 0 false
# rotations on upright ones; top-down food/macro shots (no true "up") are left
# unchanged via the confident=false gate. ~¥0.0015/image (4 small images + capped
# thinking). EXIF orientation is always baked in first — this pass catches photos
# whose EXIF is wrong (content sideways anyway). Runs once per posted photo on the
# winner (pick-4 caps candidates at 512px internally); fails open, never blocks.
ROTATION_ENABLED=true
ROTATION_MODEL=qwen3.5-flash, 800, 1200

# ── Scene dedup (cheap VLM "same scene/object" gate) ─────────────────────────
# After pHash dedup, compare the winner against the last N POSTED images with ONE
# cheap low-res vision call. Rejects re-posting the SAME scene/object — portrait-
# vs-landscape, crop, tiny angle (which pHash can't catch) — while ALLOWING two
# DIFFERENT things of the same kind (two different dishes/sunsets). Runs on the
# thumbnail before the full-res download; ~1 call per posted photo → negligible.
# Fails OPEN (any error allows the post). Use a DashScope model (reliable in CN);
# gemini had connection failures. Calibrate first: `ic2x scene-dedup-test --dir <folder>`.
SCENE_DEDUP_ENABLED=true
# Scene GROUPING at burst assembly: when pHash says the next shot is a different
# scene, double-check with one cheap VLM call ("same scene shot differently?").
# Merges portrait/landscape/angle variants of ONE scene into a single burst, so
# best-of-burst picks the best framing and the variants aren't re-judged later.
# pHash handles the obvious cases free; AI fires only at a hash boundary (~¥1/mo).
SCENE_GROUP_ENABLED=true
SCENE_DEDUP_MODEL=qwen3-vl-flash   # shared by dedup + grouping
SCENE_DEDUP_RECENT_N=6        # rolling window of recent posts to compare against (dedup)
SCENE_DEDUP_IMAGE_MAX_PX=384
SCENE_THUMBS_DIR=./scene_thumbs

# ── Local adaptive polish (free, CPU-only — no GPU, no API, no cost) ──────────
# Measure-then-correct white-balance / levels / exposure / saturation / sharpen on
# the posted image. Adaptive: a well-exposed, well-balanced photo comes out nearly
# untouched, so it's safe to leave on. Runs BEFORE the paid Aliyun color enhance, so
# you can use it ALONE (set COLOR_ENHANCE_ENABLED=false) as a zero-cost alternative,
# or stack both. Calibrate on real photos first: `ic2x polish-test --dir <folder>`
# (or `--count N` for the iCloud newest N) → polish_out/<ts>/ before/after montages.
POLISH_ENABLED=false
POLISH_INTENSITY=natural          # natural (subtle) | punchy (stronger, adds sharpen) | off

# ── InstructIR enhancement (optional, needs local GPU; currently not wired into
#    the posting loop — kept for the offline `enhance.enhance_image` helper) ────
ENHANCE_ENABLED=false
ENHANCE_INSTRUCTIR_DIR=~/Programming/InstructIR
ENHANCE_PROMPT=sharpen this image, remove blur, improve clarity

# ── Aliyun VIAPI image enhancement (test harness) ────────────────────────────
# `ic2x enhance-test [--count N] [--dir FOLDER] [--capabilities superres,color]`
# tries Alibaba Cloud VIAPI imageenhan (super-resolution UpscaleFactor=1 = enhance-
# only, + auto color) on real photos → enhance_out/<ts>/ before/after montages.
# Needs the AccessKey in .env (ALIBABA_CLOUD_ACCESS_KEY_ID/_SECRET — NOT the
# DashScope key) and the imageenhan category activated in the VIAPI console.
# Real calls: first 100/month free, then 0.02 RMB each.
#
# Color enhancement applied to every POSTED image (EnhanceImageColor). ln17_256 =
# stronger pop (chosen); Rec709 = natural. Fail-open — a failure just posts the
# un-enhanced image; the per-call cost flows into `ic2x cost`. Needs the same
# AccessKey + the imageenhan category activated in the VIAPI console.
COLOR_ENHANCE_ENABLED=true
COLOR_ENHANCE_MODE=ln17_256       # Rec709 | ln17_256 | LogC
COLOR_ENHANCE_MAX_EDGE=1920       # downscale long edge before sending (≤1920 proven safe)
COLOR_ENHANCE_COST_RMB=0.02       # per call beyond the free monthly quota (cost tracking)
COLOR_ENHANCE_FREE_QUOTA=100      # free calls/calendar-month; only calls past this are charged
