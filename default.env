# App defaults — safe to commit. Secrets (API keys) go in .env (gitignored).
#
# Model settings accept an optional thinking-effort suffix after a comma:
#   MODEL_VAR=gemini-2.5-flash, low
# Accepted effort values: off | low | high  (omit = provider default)
#
# Available models:
#   Local Ollama  (no API key needed — runs on OLLAMA_BASE_URL)
#     qwen3-vl:8b             — vision-language, fast on local GPU
#     qwen3-vl:30b            — higher quality (add to exact_models in ai_client.py)
#
#   Google Gemini  (GEMINI_API_KEY)
#     gemini-2.5-flash            — fast, good quality      [thinking: off/low/high]
#     gemini-2.5-flash-lite       — cheapest / fastest      [thinking: off/low/high]
#     gemini-2.5-pro              — best stable quality     [thinking: always on]
#
#   xAI Grok  (XAI_API_KEY)
#     grok-4                      — flagship
#     grok-4-1-fast-non-reasoning — fast, low cost
#
#   Alibaba Qwen  (DASHSCOPE_API_KEY)
#     qwen3.6-plus       — balanced quality/speed          [thinking: off/high]
#     qwen3-max          — best quality                    [thinking: off/high]

# Ollama server URL — override in .env with a Tailscale IP to offload to another machine.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Max long-edge pixel size for images sent to Ollama.
# Unset = full resolution (best for dedicated GPU / Tailscale offload).
# Set to 1024 on memory-constrained machines to cap KV cache RAM usage.
# OLLAMA_IMAGE_MAX_PX=1024

# Fallback model for all ic2x AI calls.
AI_DEFAULT_MODEL=gemini-2.5-flash

# Safety + quality model — one combined call per image (halves AI budget usage).
JUDGE_MODEL=gemini-2.5-flash

# Max long-edge pixel size for images sent to the judge (cloud providers).
# Unset = 1024. Override only if you need higher/lower resolution.
# JUDGE_IMAGE_MAX_PX=1024

# ── iCloud ────────────────────────────────────────────────────────────────────
# ICLOUD_USERNAME must be set in .env (your Apple ID email)
ICLOUD_USERNAME=
ICLOUD_RECENT_COUNT=20
# icloudpd --until-found: stop after N consecutive already-downloaded photos. 0 = disabled.
ICLOUD_UNTIL_FOUND=3
ICLOUD_COOKIE_DIR=./icloud_auth

# ── Paths (relative to project root) ─────────────────────────────────────────
INBOX_DIR=./inbox
QUEUE_DIR=./queue
APPROVED_DIR=./approved
POSTED_DIR=./posted
REJECTED_DIR=./rejected
DB_PATH=./state.db
LOGS_DIR=./logs

# ── Proxy — IC2X_ prefix avoids clashing with system HTTP_PROXY ──────────────
IC2X_HTTP_PROXY=
IC2X_HTTPS_PROXY=

# ── X / Twitter ───────────────────────────────────────────────────────────────
X_DRY_RUN=true

# ── Limits ────────────────────────────────────────────────────────────────────
DAILY_AI_CALLS=200
HAMMING_THRESHOLD=12

# ── InstructIR enhancement (optional, needs local GPU) ───────────────────────
ENHANCE_ENABLED=false
ENHANCE_INSTRUCTIR_DIR=~/Programming/InstructIR
ENHANCE_PROMPT=sharpen this image, remove blur, improve clarity

# ── Review / Daemon ───────────────────────────────────────────────────────────
# Set AUTO_APPROVE=true for fully unattended daemon operation (ic2x daemon).
# When true, images that pass AI quality checks go directly to approved/ and
# are posted without manual review.
AUTO_APPROVE=false

# Images with pHash Hamming distance ≤ this value are bundled into one tweet (max 4 per tweet).
# Set to 0 to always post images separately. Must be > HAMMING_THRESHOLD (12) to have any effect.
GROUP_HAMMING_THRESHOLD=30

# Minimum hours between X posts (daemon mode). Default: 8.
POST_INTERVAL_HOURS=8

# How often the daemon checks whether a post is due, in seconds. Default: 1800 (30 min).
DAEMON_CHECK_INTERVAL=1800

# Maximum --recent value when stepping back through iCloud history. Default: 200.
ICLOUD_LOOKBACK_MAX=200
