# iCloud
ICLOUD_PASSWORD=

# Gemini (required for default models)
GEMINI_API_KEY=
GOOGLE_API_KEY=     # accepted as fallback for GEMINI_API_KEY

# xAI Grok (optional — use grok-* models)
XAI_API_KEY=

# Alibaba Qwen (optional — use qwen* models)
DASHSCOPE_API_KEY=

# Twitter/X
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
