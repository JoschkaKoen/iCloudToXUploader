# iCloud
ICLOUD_USERNAME=
ICLOUD_PASSWORD=

# Gemini (required if you use gemini-* models)
GEMINI_API_KEY=
GOOGLE_API_KEY=     # accepted as fallback for GEMINI_API_KEY

# xAI Grok (optional — use grok-* models)
XAI_API_KEY=

# Alibaba Qwen / DashScope (required for default Qwen models in default.env)
DASHSCOPE_API_KEY=

# Moonshot Kimi (optional — use kimi* / moonshot* models)
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional: AI debugging (see default.env)
# IC2X_AI_RESPONSE_CACHE=1
# IC2X_AI_PROMPT_LOG_DIR=./logs/ai_prompts

# Optional: pricing & cost artifacts (see default.env; committed JSON defaults to RMB/xScore-aligned export)
# IC2X_AI_PRICING_JSON=
# IC2X_AI_PRICING_SOURCE_XLSX=
# IC2X_AI_COST_ARTIFACTS=1

# Twitter/X
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
